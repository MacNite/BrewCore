    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:drift": "node scripts/check-migration-drift.mjs",
    "db:seed": "tsx prisma/seed-catalogue.ts",
    "db:seed:catalogue": "tsx prisma/seed-catalogue.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "argon2": "0.44.0",
    "next": "^15.5.24",
    "next-intl": "^4.14.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "^15.5.24",
    "fake-indexeddb": "^6.0.0",
    "prisma": "6.15.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed-catalogue.ts"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
