# ---------------------------------------------------------------------------
# BrewCore configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Public URL of the application. Cookies are marked Secure when this is https.
APP_URL=http://localhost:3000
APP_PORT=3000

# Prebuilt images from the "Publish image" workflow. Pin BOTH to the same tag
# for a reproducible deployment, e.g. ghcr.io/macnite/brewcore:0.1.0 — running
# migrations from one release against the code of another is exactly what the
# migrate service exists to prevent. Ignored by `docker compose up -d --build`.
APP_IMAGE=ghcr.io/macnite/brewcore:latest
MIGRATE_IMAGE=ghcr.io/macnite/brewcore-migrate:latest

# --- Database --------------------------------------------------------------
# Compose builds DATABASE_URL from these; set it directly only when running
# the app outside compose.
POSTGRES_DB=brewcore
POSTGRES_USER=brewcore
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://brewcore:change-me@localhost:5432/brewcore?schema=public

# Absolute paths on a NAS, e.g. /mnt/tank/apps/brewcore/postgres
POSTGRES_DATA_PATH=./data/postgres
BACKUP_PATH=./backups

# --- Accounts --------------------------------------------------------------
# Who may create an account without an invitation.
#   bootstrap (default) - sign-up works until the first account exists, which
#                         becomes the administrator; then invitation links only
#   invite              - alias for bootstrap
#   open                - anyone who can reach the page may register
#   disabled            - no self-registration at all, including the first
REGISTRATION_MODE=bootstrap
# How long an invitation link stays valid.
INVITATION_EXPIRY_HOURS=48

# --- Single sign-on (OpenID Connect, e.g. authentik) -------------------------
# Optional. Adds a "Sign in with ..." button; accounts are matched by email on
# the first sign-in and then bound to the provider's subject. In authentik:
# create an OAuth2/OpenID provider (confidential client) with redirect URI
#   ${APP_URL}/api/auth/oidc/callback
# and, for single logout, ${APP_URL}/login as well. See README "Single sign-on".
OIDC_ENABLED=false
# The provider's issuer, e.g. https://auth.example.com/application/o/brewcore/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=authentik
# Create an account on first sign-in when no account has the email. Off: only
# existing accounts and open invitations can sign in.
OIDC_AUTO_CREATE=false
# Refuse emails the provider does not mark as verified (email_verified).
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Also end the provider session on sign-out.
OIDC_SINGLE_LOGOUT=true
# false = single sign-on only: hides the password form, registration and
# password invitations. Administrators keep a break-glass password sign-in at
# /login?local=1. Ignored (with a warning) while single sign-on is not configured.
AUTH_PASSWORD_LOGIN=true

# --- Localisation ----------------------------------------------------------
# Default for new accounts and signed-out visitors: de or en.
DEFAULT_LOCALE=de

# --- Uploads ---------------------------------------------------------------
# Maximum size of a coffee bag photo in whole MiB (default 5, max 15). Read at
# BUILD time for the request-body ceiling; at runtime it can only tighten.
IMAGE_UPLOAD_MAX_MB=5

# --- Security / operations -------------------------------------------------
# Number of reverse proxies that append to X-Forwarded-For. 0 (default) means
# the header is not trusted, which is right for the stock compose stack.
TRUSTED_PROXY_HOPS=0
# Set only when TLS is terminated somewhere the app cannot see.
# ALLOW_INSECURE_APP_URL=false
LOG_LEVEL=info

# Only read by `npm run db:seed:demo` (development only).
SEED_PASSWORD=
